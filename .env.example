# Frontend
# For local development keep this empty to use Vite proxy (/api -> localhost:4000)
# For production set this to your deployed backend URL, for example:
# VITE_API_BASE=https://your-backend.onrender.com/api
VITE_API_BASE=

# Backend (Render/Railway/Fly)
# Must match the exact browser origin (scheme + host, no trailing slash).
# Vercel preview URLs differ from production — list several, comma-separated:
# CORS_ORIGIN=https://my-app.vercel.app,https://my-app-git-main-user.vercel.app
# Or temporarily while debugging:
# CORS_ORIGIN=*
CORS_ORIGIN=*
